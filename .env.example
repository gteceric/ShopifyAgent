DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce_ops?schema=public"
DATABASE_URL_SMOKE="postgresql://postgres:postgres@localhost:5432/commerce_ops_smoke?schema=public"

# Real Shopify mode makes the web app resolve each merchant's Admin client from
# the stored ShopifyInstallation token. It does not use SHOPIFY_ADMIN_TOKEN.
USE_REAL_SHOPIFY="true"

# Shopify app configuration. Shopify CLI may inject SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, and APP_URL during app dev; production should provide the
# SHOPIFY_APP_* names directly.
SHOPIFY_APP_CLIENT_ID=""
SHOPIFY_APP_CLIENT_SECRET=""
SHOPIFY_APP_URL=""
SHOPIFY_API_VERSION="2026-01"
SHOPIFY_TOKEN_ENCRYPTION_KEY=""
SHOPIFY_TOKEN_MAINTENANCE_BATCH_SIZE="100"

# Refund execution is a separate safety gate from USE_REAL_SHOPIFY. Keep this
# false/unset unless real refund creation is intentionally enabled.
ENABLE_REAL_REFUND_EXECUTION="false"

# Optional model responder settings. Leave RESPONSE_MODEL_PROVIDER unset to use
# Ollama when OLLAMA_MODEL or OLLAMA_ENDPOINT is configured; set "none" for the
# deterministic fallback.
RESPONSE_MODEL_PROVIDER=""
OLLAMA_MODEL=""
OLLAMA_ENDPOINT="http://localhost:11434/api/chat"
OLLAMA_TIMEOUT_MS="12000"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2"
OPENAI_TIMEOUT_MS="8000"

# Manual/smoke tools only. The multi-merchant web app and reconciliation path
# use stored installation tokens instead of these single-store credentials.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_TOKEN=""
