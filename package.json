{
  "name": "shopify-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('build', { recursive: true, force: true }); rmSync('packages/core/dist', { recursive: true, force: true }); rmSync('packages/core/build', { recursive: true, force: true });\"",
    "build": "npm run build:core && tsc -p tsconfig.json",
    "build:core": "npm --prefix packages/core run build",
    "cleanbuild": "npm run clean && npm run build",
    "check": "npm run build",
    "dev": "node --env-file=.env --enable-source-maps build/src/index.js",
    "mcp": "npm run build && node --env-file=.env --enable-source-maps build/src/mcp/run-stdio-server.js",
    "scenario-matrix": "npm run build && node --env-file=.env build/src/tools/run-refund-scenario-matrix.js",
    "test:core": "npm --prefix packages/core run test",
    "test:app": "npm run cleanbuild && node --test build/tests/**/*.test.js",
    "test": "npm run test:core && npm run test:app"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@shopify-agent/core": "workspace:*",
    "zod": "^4.3.6"
  }
}
