  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MCP server test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--enable-source-maps",
        "--test",
        "--test-name-pattern=initialize advertises tool capabilities",
        "${workspaceFolder}/build/tests/mcp-server.test.js"
      ],
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/build/**/*.js"]
    }
  ]
}
